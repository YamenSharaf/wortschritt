# Copy to .env and adjust. These are read by the API (packages/api).

# Admin account created on first boot: log in with ADMIN_USERNAME and
# APP_PASSWORD. After that, change the password in Settings → Account
# (APP_PASSWORD is only read when the first user is created).
ADMIN_USERNAME=admin
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Use a long random string.
SESSION_SECRET=please-change-this-to-a-long-random-string

# Port the API (and, in production, the bundled web UI) listens on.
PORT=3000

# Path to the SQLite database file. In Docker this lives on a mounted volume.
DATABASE_PATH=./data/app.db

# Directory holding git-versioned JSON content (cheatsheets + exercises).
CONTENT_DIR=./content

# Set to "production" in the container. Controls static SPA serving.
NODE_ENV=development

# --- Branding (optional) ---------------------------------------------------
# Shown in the header/title; the emoji is also used as the browser favicon.
APP_NAME=mit dem baby
APP_EMOJI=🍼

# --- AI tutor (optional) ---------------------------------------------------
# Each user connects their own OpenAI-compatible provider in the app
# (Settings → AI tutor). Their API keys are encrypted with ENCRYPTION_KEY.
# Generate it with `openssl rand -base64 32` and keep a copy somewhere safe:
# if it's lost or changed, saved AI keys must be re-entered (nothing else).
ENCRYPTION_KEY=

# Legacy single-user config: if set, copied ONCE into the admin's AI settings
# on first boot (then unused — change it in the app instead).
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_API_KEY=sk-...
# ASSISTANT_MODEL=gpt-4o-mini

# --- MCP connectors (optional) ------------------------------------------------
# The app's public URL, used as the OAuth issuer when an AI agent (e.g. a Claude
# connector) signs in at /mcp. Unset = derived from the request's Host and
# X-Forwarded-Proto headers, which works behind a Cloudflare tunnel.
# PUBLIC_URL=https://deutsch.example.com

# --- Dictionary (optional) ------------------------------------------------------
# Tapping a word shows the offline gloss instantly, then English definitions,
# pronunciation and examples from Wiktionary (via freedictionaryapi.com),
# cached in the database. Set to "off" to stay fully offline.
# DICTIONARY_API_URL=https://freedictionaryapi.com/api/v1
