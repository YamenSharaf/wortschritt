# Copy to .env and adjust. These are read by the API (packages/api).

# The single password you log in with. CHANGE THIS.
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Use a long random string.
SESSION_SECRET=please-change-this-to-a-long-random-string

# Port the API (and, in production, the bundled web UI) listens on.
PORT=3000

# Path to the SQLite database file. In Docker this lives on a mounted volume.
DATABASE_PATH=./data/app.db

# Directory holding git-versioned JSON content (cheatsheets + exercises).
CONTENT_DIR=./content

# Set to "production" in the container. Controls static SPA serving.
NODE_ENV=development

# --- Branding (optional) ---------------------------------------------------
# Shown in the header/title; the emoji is also used as the browser favicon.
APP_NAME=mit dem baby
APP_EMOJI=🍼

# --- AI tutor (optional) ---------------------------------------------------
# Highlight-to-explain assistant. Works with any OpenAI-compatible API.
# Leave all three unset to disable the feature (the UI hides itself).
#
# Hosted (OpenAI):
#   ASSISTANT_API_KEY=sk-...
#   ASSISTANT_MODEL=gpt-4o-mini
# Local model (no key needed), e.g. Ollama on your homelab:
#   ASSISTANT_BASE_URL=http://ollama:11434/v1
#   ASSISTANT_MODEL=llama3.1
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini

# --- Pronunciation / TTS (optional) ----------------------------------------
# Neural German voices via the Piper sidecar (see docker-compose). The app
# proxies to it and caches clips. Leave TTS_URL empty (and drop the piper
# service) to fall back to the browser's built-in voice everywhere.
#   TTS_URL=http://piper:5000
TTS_URL=
