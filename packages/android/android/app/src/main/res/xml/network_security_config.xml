<?xml version="1.0" encoding="utf-8"?>
<!-- https only: the app talks to the learner's server over TLS, trusting the
     system's certificate authorities (not user-added ones). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
