        {
          "en": "the cinema",
          "de": "das Kino"
        }
      ],
      "answer": {
        "accept": [
          "Am Samstag sind wir ins Kino gegangen.",
          "Wir sind am Samstag ins Kino gegangen."
        ]
      },
      "explanation": "„gehen“ ist eine Bewegung: Perfekt mit „sein“."
    },
    {
      "type": "translate",
